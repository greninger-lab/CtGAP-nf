// ---- Profiles ----
profiles {
    docker {
        docker.enabled      = true
        singularity.enabled = false
    }
    docker_batch {
        docker.enabled         = true
        singularity.enabled    = false
        process.executor       = 'awsbatch'
        includeConfig("${System.getProperty('user.home')}/.nextflow/configs/batch.config")
    }
    singularity {
        singularity.enabled = true
        docker.enabled      = false
    }
    test {
        params.indir  = "${projectDir}/../test/input"
        params.outdir = "${projectDir}/../test/output"
    }
    local {
        // Override database paths for local testing
        // Set these to your local copies of the databases
        params.host_reference      = "${projectDir}/../resources/grch38.fasta"
        params.kraken_db           = "${projectDir}/../resources/standardDB"
        params.bakta_db            = "${projectDir}/../resources/bakta_db"
        params.resources_path      = "${projectDir}/../resources/references"
    }
}

// ---- AWS Batch settings ----
aws {
    batch {
        maxParallelTransfers = 4
    }
}

// ---- Execution defaults ----
executor {
    name = 'local'
    cpus = Runtime.runtime.availableProcessors()
}

// ---- Timeline / Report ----
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}

// ---- Manifest ----
manifest {
    name            = 'CtGAP-nf'
    author          = 'CtGAP developers'
    description     = 'Chlamydia trachomatis Genome Assembly Pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}
