/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    CtGAP Nextflow Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // ---- Input / Output ----
    indir               = "${projectDir}/../fastq"
    input_csv           = null    // Optional: CSV file with header row and columns: sample,fastq_1,fastq_2
    outdir              = "./output"
    truncate_sample_names = true  // Strip _S##_L### suffixes from glob-derived sample names (Illumina convention)

    // ---- AWS Batch resource labels (used by batch.config) ----
    labName             = "greninger"

    // ---- Organism & Mode ----
    organism            = "ct"
    mode                = "auto"          // 'denovo', 'reference-denovo', 'auto'
    reference           = "plurality"     // 'plurality', 'reference_set', or a filename

    // ---- Base resources directory on S3 mount ----
    resources_base      = "/mnt/s3/dlmp-research/labs/greninger/greninger-lab-file-share/refs/CtGAP/resources"
    resources_path      = "${params.resources_base}/references"

    // ---- Host reference (for scrubbing) ----
    host_reference      = "${params.resources_base}/grch38.fasta"
    host_bt2_prefix     = "${params.resources_base}/grch38.bt2/grch38"

    // ---- Databases ----
    kraken_db           = "${params.resources_base}/standardDB"
    bakta_db            = "${params.resources_base}/bakta_db/db-light"
    mlst_db             = "${params.resources_path}/ct/pubmlst"

    // ---- CT typing (optional) ----
    ct_typing_enabled   = false

    // ---- Annotation (optional) ----
    annotation_enabled  = true

    // ---- Mixed detection (optional) ----
    mixed_detection_enabled = true

    // ---- Assembly filtering ----
    assembly_filter_enabled = true
    filter_min_identity     = 90
    filter_min_coverage     = 50

    // ---- BLAST typing (pre-built DBs on mount) ----
    ompa_blast_db_prefix     = "${params.resources_path}/ct/ompaBlastDB/ompa21"
    secondary_blast_db_prefix = "${params.resources_path}/ct/secondaryBlastDB/secondary"
    plasmid_blast_db_prefix  = "${params.resources_path}/ct/20_Ct_plasmids"

    // ---- Phylogeny ----
    individual_refs         = "${params.resources_path}/${params.organism}/individual"

    // ---- CT typing parameters ----
    ct_refs_mash_sketch     = "${params.resources_path}/${params.organism}/ct_refs.msh"
    ct_mash_k               = 31
    ct_mash_sketch_size     = 50000
    ct_fastani_fragLen      = 3000
    ct_fastani_minFraction  = 0.3
    ct_delta_ani            = 0.001
    ct_min_ani_cov          = 0.95
    ct_min_mash_margin      = 5e-5
    ct_high_ani             = 99.95
    ct_med_ani              = 98.0

    // ---- Annotation parameters ----
    annotation_min_coverage = 90
    ct_reference_size       = 1043000
    bakta_genus             = "Chlamydia"
    bakta_species           = "trachomatis"
    bakta_gram              = "?"

    // ---- Mixed detection parameters ----
    mixed_het_threshold     = 50
    mixed_min_af            = 0.15
    mixed_max_af            = 0.85
    mixed_min_depth         = 10
    mixed_min_base_qual     = 20
    mixed_min_strand_reads  = 2

    // ---- Plasmid parameters ----
    ref_plasmid             = "${params.resources_path}/ct/reference_plasmid.fasta"
    plasmid_bt2_prefix      = "${params.resources_path}/ct/pCT"
    plasmid_mlst_db         = "${params.resources_path}/ct/pubmlst"
    plasmid_min_reads       = 100
    plasmid_expected_size   = 7500
    plasmid_min_size        = 6000
    plasmid_max_size        = 10000

    // ---- Reference paths ----
    refset              = "${params.resources_path}/${params.organism}/refset.fasta"
    refset_bt2_prefix   = "${params.resources_path}/${params.organism}/refset"
    scaffold_ref        = "${params.resources_path}/${params.organism}/scaffold.fasta"
    ref_genome          = "${params.resources_path}/${params.organism}/plurality.fasta"
    ref_genome_bt2_prefix = "${params.resources_path}/${params.organism}/plurality"

    // ---- Shovill parameters ----
    shovill_gsize       = "1.04m"
    shovill_depth       = 200

    // ---- RagTag parameters ----
    ragtag_min_len      = 1000

    // ---- HoCoRT / scrubbing parameters ----
    hocort_opts             = ""
    hocort_bowtie2_args     = ""
    chlamydiales_taxid      = 51291

    // ---- fastp parameters ----
    fastp_window_size           = 1
    fastp_mean_quality          = 3
    fastp_right_window_size     = 4
    fastp_right_mean_quality    = 15
}

// ---- Process defaults ----
process {
    withName: 'FASTP' {
        cpus   = 4
        memory = '4 GB'
        time   = '2h'
    }
    withName: 'HOCORT_DEPLETE' {
